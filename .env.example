# =============================================================================
# Copy this file to .env and adjust values as needed
# =============================================================================

# Base URL of the application under test
BASE_URL=http://localhost:3000

# Browser to run tests against: chromium | firefox | webkit
BROWSER=chromium

# Run in headed mode: true | false
HEADED=false

# Global test / step timeout in milliseconds
DEFAULT_TIMEOUT=15000

# Take screenshot on failure: true | false
SCREENSHOT_ON_FAILURE=true

# Number of retries for flaky scenarios
RETRY_COUNT=0

# Use the in-browser mock (true) or a real deployment (false)
USE_MOCK=true

# ZincBank credentials (override locally, never commit real secrets)
USERNAME=student01@zinc.test
PASSWORD=9pJolA7GBQec

# Legacy credential keys (kept for backward compatibility)
ZINC_USERNAME=student01@zinc.test
ZINC_PASSWORD=9pJolA7GBQec
