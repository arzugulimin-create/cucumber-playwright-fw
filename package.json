{
  "name": "cucumber-playwright-fw",
  "version": "1.0.0",
  "description": "End-to-end modern Cucumber + Playwright (TypeScript) test automation framework",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf reports screenshots",
    "test": "cucumber-js",
    "test:chrome": "cross-env BROWSER=chromium cucumber-js",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js",
    "test:webkit": "cross-env BROWSER=webkit cucumber-js",
    "test:headed": "cross-env HEADED=true cucumber-js",
    "test:tags": "cucumber-js --tags",
    "test:login": "cucumber-js features/login.feature",
    "test:specific": "cucumber-js features/sign-in.feature",
    "generate:report": "ts-node scripts/generate-report.ts",
    "playwright:install": "playwright install",
    "playwright:install:deps": "playwright install --with-deps",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cucumber",
    "playwright",
    "typescript",
    "bdd",
    "e2e",
    "testing"
  ],
  "author": "QA Automation Team",
  "license": "ISC",
  "dependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@playwright/test": "^1.49.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "multiple-cucumber-html-reporter": "^3.7.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
